# ============================================================
# AutoIQ CRM — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file with real values.
# ============================================================

# --- SUPABASE ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- ANTHROPIC (AI) ---
ANTHROPIC_API_KEY=sk-ant-your-api-key

# --- APIFY (Scraping) ---
APIFY_TOKEN=apify_api_your-token

# --- GMAIL (OAuth2 — for n8n) ---
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret

# --- n8n ---
N8N_WEBHOOK_URL=https://your-n8n-instance.railway.app
GENERIC_TIMEZONE=Asia/Dubai

# --- MANAGER EMAIL (for weekly reports) ---
MANAGER_EMAIL=manager@yourcompany.com

# --- PYTHON WORKERS ---
SUPABASE_KEY=your-supabase-service-role-key
BATCH_SIZE=20
RATE_LIMIT_SECONDS=1

# --- UPSTASH REDIS (optional — for dashboard caching) ---
# UPSTASH_REDIS_URL=redis://default:your-password@your-host.upstash.io:6379
